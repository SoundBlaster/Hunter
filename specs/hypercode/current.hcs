HunterPrimitives:
  status: "observed-source, initial extraction"
ScopedMetadata:
  source: "src/scoped_metadata.rs"
  boundary_spec: "hunter.fs.scoped_metadata"
DescriptorLifetime:
  implementation: "ScopedMetadata::open + owned File descriptors"
RegularFileObservation:
  implementation: "inspect_regular_file + openat/fstatat no-follow"
LocalMetadataGuard:
  implementation: "check_local + dataless; host owns thread materialization policy"
PortableDirectory:
  source: "crates/hunter-fs-core/src/lib.rs"
  implementation: "visit_directory over host-opened entries"
  boundary_spec: "hunter.fs.portable"
MetadataSizing:
  source: "crates/hunter-fs-core/src/lib.rs"
  implementation: "metadata_bytes + MeasuredSize"
  folded_into: "hunter.fs.portable"
ScopedWork:
  source: "crates/hunter-fs-core/src/work.rs"
  boundary_spec: "hunter.fs.work"
TaskQueue:
  implementation: "WorkQueue<T>, LIFO, unbounded"
  folded_into: "hunter.fs.work"
WorkerLaunch:
  implementation: "spawn_workers + worker_count; caller-owned thread Scope"
  folded_into: "hunter.fs.work"
Shutdown:
  implementation: "close_on_drop + panic close; outer Scope joins"
  folded_into: "hunter.fs.work"
DirectoryTasks:
  source: "crates/hunter-fs-core/src/task.rs"
  boundary_spec: "hunter.fs.directory_tasks"
MeasurementPlanning:
  implementation: "DirectoryTask::measurement_plan + DirectoryMeasurementPlan::measure"
  folded_into: "hunter.fs.directory_tasks"
ResultEnvelope:
  implementation: "DirectoryListing + DirectoryMeasurement + DirectoryResult"
  folded_into: "hunter.fs.directory_tasks"
ChildTraversal:
  source: "crates/hunter-fs-core/src/children.rs"
  boundary_spec: "hunter.fs.child_traversal"
HostSelection:
  implementation: "ChildTraversal::next_child + ChildDecision"
  folded_into: "hunter.fs.child_traversal"
RecursiveRequests:
  implementation: "PlannedChild + DirectoryRequest::into_task"
  folded_into: "hunter.fs.child_traversal"
TaskLedger:
  source: "crates/hunter-fs-core/src/ledger.rs"
  boundary_spec: "hunter.fs.task_ledger"
TaskIdentity:
  implementation: "DirectoryTaskLedger::register + take_listing"
  folded_into: "hunter.fs.task_ledger"
ResponseAccounting:
  implementation: "response_received + outstanding; host protocol ordering"
  folded_into: "hunter.fs.task_ledger"
DeferredState:
  implementation: "defer_measurement + take_measurement; owned opaque state"
  folded_into: "hunter.fs.task_ledger"
SubtreeProgress:
  source: "crates/hunter-fs-core/src/subtree.rs"
  boundary_spec: "hunter.fs.subtree_progress"
ByteAggregation:
  implementation: "add_bytes saturating u64 + set_bytes"
  folded_into: "hunter.fs.subtree_progress"
CompletionReadiness:
  implementation: "pending directory/root flags + is_ready/is_completed"
  folded_into: "hunter.fs.subtree_progress"
PartialCompletion:
  implementation: "mark_partial + complete(force_partial); one owned result"
  folded_into: "hunter.fs.subtree_progress"
ScanExecution:
  source: "crates/hunter-fs-core/src/execution.rs"
  boundary_spec: "hunter.fs.scan_execution"
ResultPump:
  implementation: "drive_scan + ScanCoordinator, serial receiver and opaque messages"
  folded_into: "hunter.fs.scan_execution"
IdleCheckpoint:
  implementation: "positive optional timeout repeats host checkpoint without receipt"
  folded_into: "hunter.fs.scan_execution"
StopBoundary:
  implementation: "receipt accounting before stop check; stopped message is not dispatched"
  folded_into: "hunter.fs.scan_execution"
FilesystemBackend:
  source: "crates/hunter-fs-core/src/backend.rs"
  boundary_spec: "hunter.fs.backend"
NativePathAccess:
  implementation: "StdFilesystem + FilesystemBackend symlink_metadata/read_dir"
  folded_into: "hunter.fs.backend"
RootObservation:
  implementation: "observe_root; one metadata call, owned Directory/Entry facts"
  folded_into: "hunter.fs.backend"
DirectoryWorker:
  source: "crates/hunter-fs-core/src/worker.rs"
  boundary_spec: "hunter.fs.directory_worker"
TaskExecution:
  implementation: "run_directory_worker + synchronous DirectoryWorker adapter"
  folded_into: "hunter.fs.directory_worker"
ListingFirst:
  implementation: "publish Listed before measure, then publish returned Measured"
  folded_into: "hunter.fs.directory_worker"
PublicationBoundary:
  implementation: "false publication returns before next effect/task; host owns queue closure"
  folded_into: "hunter.fs.directory_worker"
DirectoryAcquisition:
  source: "crates/hunter-fs-core/src/listing.rs"
  boundary_spec: "hunter.fs.directory_listing"
OrderedCollection:
  implementation: "collect_directory + visit_directory; one owned children/errors listing"
  folded_into: "hunter.fs.directory_listing"
ContextObservation:
  implementation: "synchronous entry/context observer; errors retain child and context"
  folded_into: "hunter.fs.directory_listing"
AcquisitionOutcome:
  implementation: "preserved Completed/Cancelled/OpenFailed and partial listing"
  folded_into: "hunter.fs.directory_listing"
MeasurementBackend:
  source: "crates/hunter-fs-core/src/measurement.rs"
  boundary_spec: "hunter.fs.measurement_backend"
DirectoryPreparation:
  implementation: "directory_metadata then prepare_files before cancellation"
  folded_into: "hunter.fs.measurement_backend"
PreparedFileEffects:
  implementation: "owned FileMeasurementBackend; host effects/fallbacks/guards"
  folded_into: "hunter.fs.measurement_backend"
SharedSlotExecution:
  implementation: "task.rs measure/measure_with share measure_prepared loop"
  folded_into: "hunter.fs.measurement_backend"
